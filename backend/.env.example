# ---------- Banco (Supabase) ----------
# Supabase > Project Settings > Database > Connection string > URI (direct, nao pooler)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ---------- App ----------
PORT=3000
NODE_ENV=development
# Expor a UI do Swagger em /docs. Desligue em producao.
SWAGGER_ENABLED=true
# Obrigatorio, minimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-valor-em-producao-por-um-aleatorio-de-32-mais"
JWT_EXPIRES_IN="12h"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---------- Solana ----------
# Rede: devnet | testnet | mainnet-beta
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
SOLANA_COMMITMENT="confirmed"
# Carteira da plataforma: patrocina a taxa. Nunca commitar a secret key.
SOLANA_FEE_PAYER_SECRET_KEY=""
# Carteira da tesouraria do piloto ficticio (so a publica e necessaria)
SOLANA_TREASURY_PUBKEY=""

# ---------- Negocio ----------
# Percentual da economia liquida comprovada que vai para o fundo de permanencia
FUND_SHARE_PCT=30
# Referencia de planejamento para custo de cobranca por liquidacao
BANK_FEE_PER_LIQUIDATION=7.00
# Mint SPL usado no split (USDC em devnet)
USDC_MINT=""

# ---------- Seed ----------
SEED_STUDENT_COUNT=1000
SEED_INSTITUTION_NAME="Universidade Claritas"
SEED_PASSWORD="claritas123"
